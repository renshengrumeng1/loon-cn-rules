#!name=百度贴吧 [签到]
#!desc=百度贴吧每日签到，单独拆出。获取Cookie：打开贴吧App点「我的」，提示获取成功即可。每天08:40自动签到你关注的贴吧。
#!author=NobyDa（原脚本 @sazs34）
#!homepage=https://github.com/NobyDa/Script/tree/master/BDTieBa-DailyBonus
#!icon=https://raw.githubusercontent.com/NobyDa/mini/master/Color/tieba.png

[Script]
cron "40 8 * * *" script-path=https://raw.githubusercontent.com/NobyDa/Script/master/BDTieBa-DailyBonus/TieBa.js, img-url=https://raw.githubusercontent.com/NobyDa/mini/master/Color/tieba.png, timeout=300, enabled=true, tag=百度贴吧 [签到]

http-request ^https?:\/\/(c\.tieba|tiebac)\.baidu\.com\/c\/s\/login script-path=https://raw.githubusercontent.com/NobyDa/Script/master/BDTieBa-DailyBonus/TieBa.js, img-url=https://raw.githubusercontent.com/NobyDa/mini/master/Color/tieba.png, enabled=true, tag=百度贴吧 [Cookie]

[MITM]
hostname = c.tieba.baidu.com, tiebac.baidu.com
