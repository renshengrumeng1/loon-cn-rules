#!name=PingMe签到（手工转）
#!desc=由 QX 脚本手工转成 Surge 模块：自动签到+视频奖励。原作者 怎么肥事 / ZenmoFeiShi。需先打开一次 PingMe 触发请求头捕获账号；定时任务每天 8:30、20:30。
#!category=手工转换

[Script]
PingMe捕获 = type=http-request,pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus,script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/PingMe.js
PingMe签到 = type=cron,cronexp="30 8,20 * * *",script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/PingMe.js,timeout=120

[MITM]
hostname = %APPEND% api.pingmeapp.net
