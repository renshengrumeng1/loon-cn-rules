#!name=嘿嘿漫画（手工转）
#!desc=由 Loon 插件手工转成 Surge 模块：付费/会员章节。原作者 WeiGiegie。
#!category=手工转换

[Script]
嘿嘿漫画余额 = type=http-response,pattern=^https?:\/\/api.manxinao.com\/api\/User\/getBalance,script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/hhmh.js,requires-body=1
嘿嘿漫画章节 = type=http-request,pattern=^https?:\/\/api.manxinao.com\/api\/Commodity\/(buychapter|chadetail),script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/hhmh.js

[MITM]
hostname = %APPEND% api.manxinao.com
